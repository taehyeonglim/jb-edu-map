# Optional. The committed school/statistics data works without API keys.
NEXT_PUBLIC_VWORLD_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_EDU_MAP_PROFILE=jeonbuk

# Server-only building API credentials; never use NEXT_PUBLIC_ for this key.
VWORLD_BUILDING_KEY=
VWORLD_BUILDING_DOMAIN=
BUILDINGS_ENABLED=true
NEXT_PUBLIC_BUILDINGS_ENABLED=true

# Optional: set to off to disable map effects.
NEXT_PUBLIC_MAP_FX=
